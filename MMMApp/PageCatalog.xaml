<Page x:Class="MMMApp.PageCatalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:local="clr-namespace:MMMApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageCatalog">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="94"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ToolBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <Button ToolTip="В начало" Click="Btn_Start">
                <iconPacks:PackIconMaterial Kind="SkipBackward"/>
            </Button>

            <Button ToolTip="Назад" Click="Btn_Back">
                <iconPacks:PackIconMaterial Kind="ChevronLeft"/>
            </Button>

            <TextBlock Text="{Binding CurrentIndex}" Width="25"/>
            <TextBlock Text=" из "/>
            <TextBlock Text="{Binding TotalCount}" Width="25"/>

            <Button ToolTip="Вперед" Click="Btn_Forward">
                <iconPacks:PackIconMaterial Kind="ChevronRight"/>
            </Button>

            <Button ToolTip="В конец" Click="Btn_End">
                <iconPacks:PackIconMaterial Kind="SkipForward"/>
            </Button>

            <Separator/>

            <Button ToolTip="Добавить" Click="Btn_Add">
                <iconPacks:PackIconMaterial Kind="Plus"/>
            </Button>

            <Button ToolTip="Удалить" Click="Btn_Delete">
                <iconPacks:PackIconMaterial Kind="Delete"/>
            </Button>

            <Button ToolTip="Сохранить" Click="Btn_Save">
                <iconPacks:PackIconMaterial Kind="ContentSave"/>
            </Button>
        </ToolBar>

        <!-- Код модели -->
        <TextBlock
        Grid.Row="1" Grid.Column="0"
        Text="Код модели: "
        FontSize="18"
        VerticalAlignment="Center"
        HorizontalAlignment="Right"/>

        <TextBox
        x:Name="TbCode"
        Grid.Row="1" Grid.Column="1"
        Width="400"
        Height="40"
        IsReadOnly="True" Text="{Binding model_id}"
        VerticalAlignment="Center" HorizontalAlignment="Left"/>

        <!-- Название -->
        <TextBlock
        Grid.Row="2" Grid.Column="0"
        Text="Название: "
        FontSize="18"
        VerticalAlignment="Center"
        HorizontalAlignment="Right"/>

        <TextBox
        x:Name="TbName"
        Grid.Row="2" Grid.Column="1"
        Width="400"
        Height="40" Text="{Binding name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        VerticalAlignment="Center" HorizontalAlignment="Left"/>

        <!-- Цена -->
        <TextBlock
        Grid.Row="3" Grid.Column="0"
        Text="Цена: "
        FontSize="18"
        VerticalAlignment="Center"
        HorizontalAlignment="Right"/>

        <TextBox
        x:Name="TbPrice"
        Grid.Row="3" Grid.Column="1"
        Width="400"
        Height="40" Text="{Binding price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        VerticalAlignment="Center" HorizontalAlignment="Left"/>

        <!-- Описание -->
        <TextBlock
        Grid.Row="4" Grid.Column="0"
        Text="Описание: "
        FontSize="18"
        VerticalAlignment="Center"
        HorizontalAlignment="Right"/>

        <TextBox
        x:Name="TbDescription"
        Grid.Row="4" Grid.Column="1"
        Width="400"
        Height="80"
        AcceptsReturn="True"
        TextWrapping="Wrap" Text="{Binding description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        VerticalAlignment="Center" HorizontalAlignment="Left"/>
    </Grid>
</Page>
