<Page x:Class="MMMApp.PageShop"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MMMApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageShop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock FontSize="20" Text="Название магазина: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0"/>
        <TextBox Name="r" Text="{Binding name}" Grid.Row="0" Grid.Column="1" Width="400" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>

        <TextBlock FontSize="20" Text="Адрес магазина: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0"/>
        <TextBox Name="r1" Text="{Binding address}" Grid.Row="1" Grid.Column="1" Width="400" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>

        <TextBlock FontSize="20" Text="Контактное лицо: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0"/>
        <TextBox Name="r2" Text="{Binding email}" Grid.Row="2" Grid.Column="1" Width="400" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>

        <TextBlock FontSize="20" Text="Телефон: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="0"/>
        <TextBox Name="r3" Text="{Binding phone}" Grid.Row="3" Grid.Column="1" Width="400" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>

        <Button Name="Add" Click="Add_Click" Grid.Column="1" Grid.Row="4" Width="100" Height="30" HorizontalAlignment="Right" Content="Добавить"/>
        <Button Name="Clear" Click="Clear_Click" Grid.Column="1" Grid.Row="5" Width="100" Height="30" HorizontalAlignment="Right" Content="Очистить"/>
    </Grid>
</Page>
